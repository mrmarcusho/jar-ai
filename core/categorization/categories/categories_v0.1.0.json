{
    "schema": "jar_categories",
    "version": "0.1.0",
    "description": "JAR transaction category taxonomy with keyword-to-category mapping. Categories support multi-dimensional tagging — a transaction can belong to multiple categories across dimensions.",
  
    "dimensions": {
      "spending_category": {
        "description": "What the money was spent on. Auto-assigned by keyword mapping.",
        "auto_assign": true
      },
      "household": {
        "description": "Who the expense is for. User-assigned.",
        "auto_assign": false,
        "values": ["personal", "business", "spouse", "kids", "shared"]
      },
      "budget_type": {
        "description": "How the expense behaves. Partially auto-assigned from recurrence detection.",
        "auto_assign": "partial",
        "values": ["fixed", "variable", "one_time", "recurring"]
      },
      "custom_tags": {
        "description": "User-defined tags for any purpose.",
        "auto_assign": false,
        "examples": ["tax_deductible", "reimbursable", "vacation", "wedding", "home_renovation"]
      }
    },
  
    "categories": {
