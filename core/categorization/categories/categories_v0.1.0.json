    "keyword_mapping": {
      "_description": "Rules for auto-assigning spending_category from transaction descriptions. Rules are evaluated in order — first match wins. Keywords are matched case-insensitive against description_raw and parsed_fields.ach_company_name.",
      "_match_types": {
        "contains": "keyword appears anywhere in the description",
        "starts_with": "description starts with keyword",
        "exact": "entire description matches keyword",
        "ach_company": "matches parsed_fields.ach_company_name"
      },
  
      "rules": [
        {
          "_comment": "=== HOUSING ===",
          "keywords": ["mortgage", "mr. cooper", "mr.cooper", "cooper", "NSM DBAMR"],
          "match_type": "contains",
